#include <windows.h>
#include <winver.h>

// Resource 1 is also used by the tray and application windows.
1 ICON "lingoleaf.ico"
1 RT_MANIFEST "lingoleaf.manifest"

1 VERSIONINFO
FILEVERSION 0,7,0,0
PRODUCTVERSION 0,7,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LingoLeaf\0"
            VALUE "FileDescription", "LingoLeaf Selection Translator\0"
            VALUE "FileVersion", "0.7.0.0\0"
            VALUE "InternalName", "lingoleaf\0"
            VALUE "OriginalFilename", "lingoleaf.exe\0"
            VALUE "ProductName", "LingoLeaf\0"
            VALUE "ProductVersion", "0.7.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
