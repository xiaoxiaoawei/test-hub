            VALUE "CompanyName", "LingoLeaf test fixture\0"
            VALUE "FileDescription", "Isolated updater startup fixture\0"
            VALUE "FileVersion", "0.7.2.0\0"
            VALUE "ProductVersion", "0.7.2.0\0"
            VALUE "OriginalFilename", "lingoleaf.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
