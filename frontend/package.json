{
  "name": "package-studio-ui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:model": "node --experimental-strip-types scripts/check-model.mjs",
    "test:search": "node --experimental-strip-types scripts/check-search.mjs",
    "test:layout": "node --experimental-strip-types scripts/check-layout.mjs",
    "test:ui": "npm run test:model && npm run test:search && npm run test:layout"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.1.0"
  }
}
