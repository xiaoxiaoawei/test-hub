<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PackageStudio.Altium</AssemblyName>
    <RootNamespace>PackageStudio.Altium</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OriginalCircuit.AltiumSharp" Version="1.0.2" />
    <PackageReference Include="OpenMcdf" Version="2.4.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md;THIRD-PARTY-NOTICES.txt;licenses\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
